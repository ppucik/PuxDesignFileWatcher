@model PuxDesignFileWatcher.Web.Models.AnalyzeDirectoryPageViewModel
@using PuxDesignFileWatcher.Domain.Changes

@{
    ViewData["Title"] = "Directory Analysis";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-10">
        <h1 class="mb-3">Manual Directory Analysis</h1>

        <form asp-action="Index" method="post" class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-9">
                        <label asp-for="Input.RootPath" class="form-label"></label>
                        <input asp-for="Input.RootPath" class="form-control" placeholder="C:\\path\\to\\directory" />
                        <span asp-validation-for="Input.RootPath" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-3 d-grid">
                        <button type="submit" class="btn btn-primary">Start analysis</button>
                    </div>
                </div>
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="alert alert-info">@Model.Message</div>
        }

        <div class="card border-success mb-3">
            <div class="card-header bg-success-subtle text-success-emphasis">New files (@Model.NewFiles.Count)</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Path</th>
                            <th scope="col" class="text-end">Version</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.NewFiles.Count == 0)
                        {
                            <tr><td colspan="2" class="text-muted">No new files.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Model.NewFiles)
                            {
                                <tr>
                                    <td>@item.Path</td>
                                    <td class="text-end">@item.Version</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-warning mb-3">
            <div class="card-header bg-warning-subtle text-warning-emphasis">Changed files (@Model.ChangedFiles.Count)</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Path</th>
                            <th scope="col" class="text-end">Version</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ChangedFiles.Count == 0)
                        {
                            <tr><td colspan="2" class="text-muted">No changed files.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Model.ChangedFiles)
                            {
                                <tr>
                                    <td>@item.Path</td>
                                    <td class="text-end">@item.Version</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card border-danger mb-3">
            <div class="card-header bg-danger-subtle text-danger-emphasis">Deleted files/directories (@Model.DeletedFiles.Count)</div>
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Path</th>
                            <th scope="col">Type</th>
                            <th scope="col" class="text-end">Version</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DeletedFiles.Count == 0)
                        {
                            <tr><td colspan="3" class="text-muted">No deleted items.</td></tr>
                        }
                        else
                        {
                            @foreach (var item in Model.DeletedFiles)
                            {
                                <tr>
                                    <td>@item.Path</td>
                                    <td>
                                        @if (item.EntryKind == ChangeEntryKind.Directory)
                                        {
                                            <span class="badge text-bg-secondary">Directory</span>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-light border">File</span>
                                        }
                                    </td>
                                    <td class="text-end">@(item.EntryKind == ChangeEntryKind.Directory ? "-" : item.Version)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
